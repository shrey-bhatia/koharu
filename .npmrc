# Use shared pnpm store to save disk space across projects
# Default location: ~/.pnpm-store
store-dir=~/.pnpm-store

# Hoist dependencies to root node_modules when possible
# (required for some tools that expect deps in root)
hoist=true

# Strict peer dependencies (recommended)
strict-peer-dependencies=false

# Use hard links to save space
# (pnpm's default behavior - just making it explicit)
package-import-method=clone-or-copy

# Auto-install peers
auto-install-peers=true

# Shamefully hoist (for compatibility with tools expecting flat node_modules)
shamefully-hoist=false
